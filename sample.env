DEEPGRAM_API_KEY=your_deepgram_api_key_here
PORT=8001
ELEVENLABS_API_KEY=

# Shared secret that LIFTS the anonymous rate limits (it does not gate the UI).
# Blank means every caller is privileged, which is what local dev wants.
# Generate with: openssl rand -hex 24
APP_ACCESS_TOKEN=
# Optional human-memorable alternative to the token, typed into the page's
# Unlock box. At least 12 characters; wrong guesses are rate-limited.
APP_PASSWORD=
# Set to true in deployment so a missing token fails the boot loudly.
REQUIRE_AUTH=
# Anonymous tier. Defaults are in README; override only if you need to.
# ANON_RATE_LIMIT=15
# ANON_GLOBAL_LIMIT=300
# ANON_MAX_STREAM_SECONDS=120
